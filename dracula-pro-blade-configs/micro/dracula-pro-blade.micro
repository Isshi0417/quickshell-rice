color-link default "#F8F8F2,#212C2A"
color-link comment "#70A99F"
color-link identifier "#80FFEA"
color-link identifier.class "#80FFEA"
color-link identifier.var "#F8F8F2"
color-link constant "#9580FF"
color-link constant.number "#9580FF"
color-link constant.string "#FFFF80"
color-link statement "#FF80BF"
color-link symbol "#FF80BF"
color-link preproc "#FF80BF"
color-link type "#80FFEA"
color-link special "#FFCA80"
color-link underlined "#80FFEA"
color-link error "bold #FF9580"
color-link todo "bold #FFFF80"
color-link statusline "#F8F8F2,#415854"
color-link tabbar "#F8F8F2,#1A2322"
color-link indent-char "#4C6762"
color-link line-number "#70A99F,#212C2A"
color-link current-line-number "bold #FFFF80,#212C2A"
color-link cursor-line "#2A3835"
color-link color-column "#2A3835"
color-link type.keyword "#FF80BF"
color-link symbol.operator "#FF80BF"
